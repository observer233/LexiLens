<Window x:Class="LexiLens.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LexiLens" Width="1160" Height="820" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
 <Grid Background="{StaticResource Bg}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#EDF0F4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,22">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="12,0,0,26"><TextBlock Text="LexiLens" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="屏幕翻译" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Button Content="使用引导" Click="ShowGuide" Style="{StaticResource Nav}"/><TextBlock Text="v0.5.0" Foreground="{StaticResource Muted}" FontSize="11" Margin="14,12,0,0"/></StackPanel>
    <StackPanel><Button x:Name="LiveNav" Content="翻译" Click="ShowLive" Style="{StaticResource Nav}" Background="#DFEAF8"/><Button x:Name="ReplayNav" Content="对白回看" Click="ShowReplay" Style="{StaticResource Nav}"/><Button x:Name="WordsNav" Content="生词本" Click="ShowWords" Style="{StaticResource Nav}"/><Button x:Name="SettingsNav" Content="设置" Click="ShowSettings" Style="{StaticResource Nav}"/><Button x:Name="DiagnosticsNav" Content="诊断与日志" Click="ShowDiagnostics" Style="{StaticResource Nav}"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,22,26,16">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="LivePage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><TextBlock Text="屏幕翻译" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="StateLabel" Text="未开始" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Border x:Name="GuidePanel" Grid.Row="1" Background="#EAF2FC" BorderBrush="#CEDFF4" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
     <StackPanel><Grid><TextBlock Text="首次使用" FontWeight="SemiBold"/><Button Content="收起" Click="DismissGuide" HorizontalAlignment="Right" FontSize="11" Padding="8,2" MinHeight="24"/></Grid>
      <UniformGrid Columns="3" Margin="0,8,0,0"><StackPanel Margin="0,0,12,0"><TextBlock x:Name="GuideService" Text="1. 连接翻译服务"/><Button Content="选择服务" Click="SetupProvider" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock x:Name="GuideRegion" Text="2. 选择游戏窗口或字幕"/><Button Content="选择窗口" Click="PickWindow" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel><StackPanel><TextBlock Text="3. 先试一次，再连续翻译"/><Button Content="打开练习窗口" Click="OpenPractice" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></UniformGrid>
     </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"><StackPanel>
     <WrapPanel><Button Content="选择窗口" Click="PickWindow" Margin="0,0,8,7"/><Button Content="手动框选" Click="PickRegion" Margin="0,0,8,7"/><Button Content="添加框选" Click="AddRegion" Margin="0,0,8,7"/><Button x:Name="OnceButton" Content="翻译一次" Click="TranslateOnce" Margin="0,0,8,7"/><Button x:Name="StartButton" Content="开始连续翻译" Click="ToggleTranslation" Style="{StaticResource Primary}" Margin="0,0,8,7"/><Button Content="检查识别" Click="PreviewRecognition" Margin="0,0,0,7"/></WrapPanel>
     <WrapPanel Margin="0,4,0,6"><ComboBox x:Name="AreaCombo" Width="135" DisplayMemberPath="Name" SelectionChanged="SelectArea" Margin="0,0,8,6"/><TextBox x:Name="AreaNameInput" Width="116" ToolTip="区域名称" Margin="0,0,6,6"/><Button Content="命名" Click="RenameArea" Margin="0,0,6,6"/><Button Content="移除区域" Click="RemoveArea" Margin="0,0,18,6"/><CheckBox x:Name="FastCheck" Content="快速字幕" Checked="ChangeFastMode" Unchecked="ChangeFastMode" VerticalAlignment="Center" ToolTip="每 150ms 采样，Windows OCR 优先，首次识别即提交；短对白保留到回看。特殊字体可取消此项。" Margin="0,0,0,6"/></WrapPanel>
     <TextBlock x:Name="RegionLabel" Text="尚未选择区域" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
    </StackPanel></Border>
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,14">
     <UniformGrid Columns="5"><StackPanel><TextBlock Text="截图" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CaptureStage" Text="未开始" Margin="0,5,8,0"/></StackPanel><StackPanel><TextBlock Text="文字识别" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OcrStage" Text="未开始" Margin="0,5,8,0"/></StackPanel><StackPanel><TextBlock Text="文字判断" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StabilityStage" Text="未开始" Margin="0,5,8,0"/></StackPanel><StackPanel><TextBlock Text="翻译服务" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TranslationStage" Text="未请求" Margin="0,5,8,0"/></StackPanel><StackPanel><TextBlock Text="悬浮显示" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OverlayStage" Text="未显示" Margin="0,5,0,0"/></StackPanel></UniformGrid>
    </Border>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="识别原文" FontWeight="SemiBold"/><TextBlock x:Name="PreviewBadge" Text="暂无内容" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></Grid><ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SourcePreview" Text="选择区域后，识别文字会显示在这里。" FontSize="19" LineHeight="30"/></ScrollViewer><Button Grid.Row="2" Content="预览悬浮窗" Click="PreviewOverlay" HorizontalAlignment="Left" FontSize="11" Margin="0,12,0,0"/></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="当前区域译文" FontWeight="SemiBold"/><Button Content="服务设置" Click="SetupProvider" HorizontalAlignment="Right" FontSize="11" Padding="8,1" MinHeight="24"/></Grid><ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TranslationPreview" Text="尚未发送翻译请求。" FontSize="19" LineHeight="30"/></ScrollViewer><StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="ProviderSummary" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PrivacySummary" Visibility="Collapsed"/><TextBlock x:Name="LanguageSummary" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></Border>
    </Grid>
   </Grid>
   <Grid x:Name="ReplayPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><TextBlock Text="对白回看" FontSize="25" FontWeight="SemiBold"/><Button Content="清空" Click="ClearReplay" HorizontalAlignment="Right"/></Grid><TextBlock Grid.Row="1" x:Name="ReplayCount" Text="暂无记录 · 最近 100 条，仅在本次打开期间保留" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><ListBox Grid.Row="2" x:Name="ReplayList" Background="White" BorderBrush="{StaticResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Source}" FontSize="16" Margin="0,8,0,6" TextWrapping="Wrap"/><TextBlock Text="{Binding Translation}" FontSize="18" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   <Grid x:Name="WordsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="生词本" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LookupInput" KeyDown="LookupKeyDown" ToolTip="英文单词"/><Button Grid.Column="1" Content="查词" Click="LookupWord" Margin="8,0"/><Button Grid.Column="2" Content="导出 CSV" Click="ExportWords"/></Grid>
    <ListBox Grid.Row="2" x:Name="WordsList" Background="White" BorderBrush="{StaticResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Word}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Meaning}" Margin="0,6,0,0"/><TextBlock Text="{Binding Context}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Grid Grid.Row="3" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="WordsHint" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WordCountLabel" Visibility="Collapsed"/></StackPanel><Button Content="删除所选" Click="DeleteWord" HorizontalAlignment="Right"/></Grid>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="翻译服务" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SettingsProviderSummary" VerticalAlignment="Center"/><Button Grid.Column="1" Content="配置服务" Click="SetupProvider"/></Grid><TextBlock x:Name="ProviderNotice" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="文字识别" Style="{StaticResource SectionTitle}"/>
     <CheckBox x:Name="FastSettingsCheck" Content="快速字幕模式" Margin="0,0,0,6"/><TextBlock Text="快速模式每 150ms 采样，系统 OCR 优先，增强引擎补充空结果；首次识别即提交。特殊字体可取消快速模式，使用下方所选引擎。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
     <TextBlock Text="原文语言" Margin="0,0,0,6"/><ComboBox x:Name="LanguageCombo" DisplayMemberPath="Name" SelectedValuePath="Tag"/>
     <TextBlock Text="识别引擎" Margin="0,14,0,6"/><ComboBox x:Name="OcrModeCombo"><ComboBoxItem Content="PaddleOCR v5 · 增强字体识别"/><ComboBoxItem Content="Windows OCR · 轻量识别"/></ComboBox>
     <TextBlock Text="图像处理" Margin="0,14,0,6"/><ComboBox x:Name="OcrImageCombo"><ComboBoxItem Content="自动"/><ComboBoxItem Content="原图"/><ComboBoxItem Content="暗底亮字"/><ComboBoxItem Content="低对比度"/></ComboBox>
     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="清晰优先模式的扫描间隔（毫秒）" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="IntervalInput"/></Grid>
     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="快速模式 API 最小间隔（毫秒）" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="RequestIntervalInput"/></Grid><TextBlock Text="多个区域共用此间隔，最多 2 个请求同时进行；遇到 429 会按平台要求等待。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
     <Expander Header="运行环境" Margin="0,12,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="增强识别在独立进程中运行；超时或结果为空时尝试 Windows OCR。" Foreground="{StaticResource Muted}" FontSize="12"/><Button Content="微软 VC++ 运行库说明" Click="OpenOcrRuntimeHelp" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="悬浮窗" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="OriginalCheck" Content="显示原文"/><TextBlock Text="字号" Margin="0,10,0,6"/><Slider x:Name="FontSlider" Minimum="14" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="不透明度" Margin="0,14,0,6"/><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1"/></StackPanel></Border>
    <Button Content="保存设置" Click="SaveSettings" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><TextBlock x:Name="DataLocation" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,8"/>
   </StackPanel></ScrollViewer>
   <Grid x:Name="DiagnosticsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="诊断与日志" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="DiagnosisText" Text="尚无会话记录。选择区域后，可先翻译一次。" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,0"><Button Content="测试翻译服务" Click="TestCurrentService" Margin="0,0,8,0"/><Button Content="检查识别" Click="PreviewRecognition" Margin="0,0,8,0"/><Button Content="改用 Windows OCR" Click="UseWindowsOcr"/></WrapPanel></StackPanel></Border>
    <DataGrid x:Name="LogGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="{StaticResource Line}" Background="White" FontSize="12" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="区域" Binding="{Binding AreaLabel}" Width="65"/><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="96"/><DataGridTextColumn Header="步骤" Binding="{Binding StageLabel}" Width="75"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="60"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="耗时" Binding="{Binding DurationLabel}" Width="80"/><DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="135"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><WrapPanel><Button Content="导出诊断报告" Click="ExportDiagnostics" Margin="0,0,8,0"/><Button Content="打开日志文件夹" Click="OpenLogFolder"/></WrapPanel><TextBlock Text="报告包含步骤、耗时、错误代码与配置摘要，不包含密钥、截图或游戏原文。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock x:Name="RecognitionStatus" Text="尚未运行识别" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MessageLabel" Text="选择窗口或手动框选，然后翻译一次。" FontSize="12" Margin="0,5,0,0"/><Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,8"/><TextBlock Text="快捷键（均加 Ctrl+Alt）：T 开始/停止   F 单次翻译   W 选窗口   R 重选   A 添加框选   H 隐藏全部   L 穿透全部" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
  </Grid>
 </Grid>
</Window>
