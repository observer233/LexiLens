<Window x:Class="LexiLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexiLens · 游戏里的语言伙伴" Width="1140" Height="790" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#171A1E" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18,28">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="{StaticResource Accent}" CornerRadius="9" Width="33" Height="33" Margin="0,0,9,0"><TextBlock Text="L" Foreground="#211A12" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="LexiLens" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="PLAY. READ. LEARN." Foreground="{StaticResource Muted}" FontSize="9" Margin="2,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,15"/>
          <TextBlock Text="为每一次看懂而设计" FontSize="11" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="v0.1.0  /  Windows" FontSize="10" Foreground="#66707D" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel>
          <Button x:Name="LiveNav" Content="◉   实时翻译" Style="{StaticResource Nav}" Click="ShowLive" Background="#2B2B28" Foreground="{StaticResource Accent}"/>
          <Button x:Name="WordsNav" Content="▤   我的生词本" Style="{StaticResource Nav}" Click="ShowWords"/>
          <Button x:Name="SettingsNav" Content="⚙   偏好设置" Style="{StaticResource Nav}" Click="ShowSettings"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="8,20,8,16"/>
          <Button Content="↗   打开练习场" Style="{StaticResource Nav}" Click="OpenPractice" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,22">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="LivePage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,23">
          <TextBlock Text="YOUR GAME, YOUR PACE" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,0,10"/>
          <TextBlock Text="在游戏里，读懂每一句。" FontSize="29" FontWeight="SemiBold"/>
          <TextBlock Text="保留英语世界，让不认识的词不再打断冒险。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="19,17" Margin="0,0,0,20">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
              <TextBlock x:Name="StateLabel" Text="●  准备开始" Foreground="#9FD3B4" FontSize="13"/>
              <TextBlock x:Name="RegionLabel" Text="先框选游戏中的任务详情或字幕区域" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="框选区域" Click="PickRegion" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="StartButton" Content="开始翻译  →" Click="ToggleTranslation" Style="{StaticResource Primary}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><TextBlock Text="对照阅读" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PreviewBadge" Text="示例预览" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,20">
                <StackPanel>
                  <TextBlock Text="ORIGINAL" Foreground="#78828F" FontSize="10" Margin="0,0,0,12"/>
                  <TextBlock x:Name="SourcePreview" Text="Find the ancient relic before the enemy arrives." FontSize="23" LineHeight="34" Foreground="#E0E4EA"/>
                  <Border Height="1" Background="{StaticResource Line}" Margin="0,24"/>
                  <TextBlock Text="简体中文" Foreground="#78828F" FontSize="10" Margin="0,0,0,12"/>
                  <TextBlock x:Name="TranslationPreview" Text="在敌人到达前找到古代遗物。" FontSize="20" LineHeight="32" Foreground="{StaticResource Accent}"/>
                </StackPanel>
              </ScrollViewer>
              <Button Grid.Row="2" Content="预览悬浮窗  ↗" Click="PreviewOverlay" HorizontalAlignment="Left" FontSize="11" Padding="12,8"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="翻译工作台" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <TextBlock Text="识别语言" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="LanguageSummary" Text="English → 简体中文" FontSize="13" Margin="0,6,0,14"/>
                <TextBlock Text="翻译服务" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="ProviderSummary" Text="MyMemory · 免密钥" FontSize="13" Margin="0,6,0,14"/>
                <TextBlock x:Name="PrivacySummary" Text="文字发送至 MyMemory；截图仅在本机处理。" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="18"/>
                <Button Content="调整设置  →" Click="ShowSettings" Margin="0,16,0,0" FontSize="11" Padding="10,8"/>
              </StackPanel>
            </Border>
            <Border Background="#20221F" CornerRadius="12" Padding="20">
              <StackPanel>
                <TextBlock Text="让词汇留在记忆里" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="解锁悬浮窗后，点击英文单词查看释义，再收藏到生词本。" Foreground="#B4BAAF" FontSize="11" LineHeight="19" Margin="0,10,0,0"/>
                <TextBlock x:Name="WordCountLabel" Text="已收藏 0 个单词" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
      <Grid x:Name="WordsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,25"><TextBlock Text="把冒险变成词汇量。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="保存单词，也保存你第一次遇到它的那句话。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LookupInput" ToolTip="输入英文单词" KeyDown="LookupKeyDown"/><Button Grid.Column="1" Content="查词并收藏" Click="LookupWord" Margin="10,0"/><Button Grid.Column="2" Content="导出 CSV" Click="ExportWords"/></Grid>
        <ListBox Grid.Row="2" x:Name="WordsList" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Foreground="#EEF0F4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate><DataTemplate><Border Padding="16" BorderBrush="#30343B" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Word}" FontSize="20" Foreground="#E9BD82"/><TextBlock Text="{Binding Meaning}" FontSize="14" Margin="0,8,0,6"/><TextBlock Text="{Binding Context}" Foreground="#959DAA" FontSize="12"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="WordsHint" Text="还没有收藏。可输入单词查词，或点击悬浮窗中的英文。" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,130,0"/><Button Content="删除所选" Click="DeleteWord" HorizontalAlignment="Right" Padding="14,8" FontSize="11"/></Grid>
      </Grid>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="适合你的阅读方式。" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="更改翻译或识别设置后，当前会话将暂停。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="识别与翻译" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="屏幕文字的语言（Windows OCR）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="LanguageCombo" DisplayMemberPath="Name" SelectedValuePath="Tag"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="翻译服务" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderChanged"><ComboBoxItem Content="MyMemory · 免密钥 / 联网"/><ComboBoxItem Content="Ollama · 本地模型"/></ComboBox></StackPanel>
            </Grid>
            <TextBlock x:Name="ProviderNotice" Foreground="{StaticResource Accent}" FontSize="11" LineHeight="19" Margin="0,15,0,0"/>
            <StackPanel x:Name="OllamaOptions" Visibility="Collapsed" Margin="0,15,0,0">
              <TextBlock Text="Ollama 服务地址" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="EndpointInput"/>
              <TextBlock Text="已下载的模型名称" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,7"/><TextBox x:Name="ModelInput"/>
              <TextBlock Text="先安装 Ollama 并下载模型。本机 HTTP 地址可离线使用；远程地址需 HTTPS，文字将发送到该服务器。" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="18" Margin="0,10,0,0"/>
            </StackPanel>
            <TextBlock Text="扫描间隔（毫秒，350–5000）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,17,0,7"/><TextBox x:Name="IntervalInput" Width="160" HorizontalAlignment="Left"/>
            <TextBlock Text="连续两次识别一致后翻译；实际延迟还取决于翻译服务。较短间隔会增加 CPU 使用。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="悬浮窗" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <CheckBox x:Name="OriginalCheck" Content="同时显示原文，保留学习语境"/>
            <TextBlock Text="文字大小" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,8"/><Slider x:Name="FontSlider" Minimum="14" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="整体不透明度" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,8"/><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1"/>
          </StackPanel></Border>
          <Button Content="保存设置" Click="SaveSettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
          <TextBlock x:Name="DataLocation" Foreground="#78828F" FontSize="10" Margin="0,0,0,16"/>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="0,20,0,0">
        <TextBlock x:Name="MessageLabel" Text="建议使用游戏的无边框窗口模式。先在练习场试试看。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
        <Border Height="1" Background="{StaticResource Line}"/>
        <TextBlock Text="Ctrl+Alt+T 开始/暂停     R 框选区域     H 隐藏悬浮窗     L 切换穿透（均加 Ctrl+Alt）" Foreground="#78828F" FontSize="10" Margin="0,13,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
