<Window x:Class="LexiLens.App.Views.ProviderSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="翻译服务" Width="740" Height="790" MinWidth="640" MinHeight="620" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid Background="{StaticResource Bg}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="翻译服务" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="选择服务，测试成功后保存。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
   <TextBlock Text="使用方式" Margin="0,0,0,6"/><ComboBox x:Name="ModeCombo" SelectionChanged="ModeChanged"><ComboBoxItem Content="MyMemory · 无需密钥"/><ComboBoxItem Content="Ollama · 本地翻译"/><ComboBoxItem Content="AI 平台 · 自带 API Key"/></ComboBox>
   <Border x:Name="QuickPanel" Style="{StaticResource Card}" Margin="0,16,0,0"><TextBlock Text="无需配置，直接点击“测试并保存”。识别文字发送至 MyMemory。"/></Border>
   <StackPanel x:Name="LocalPanel" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="本地模型" Margin="0,0,0,8"/><ComboBox x:Name="LocalModelCombo" IsEditable="True"/><WrapPanel Margin="0,12,0,0"><Button Content="安装 Ollama" Click="OpenOllama" Margin="0,0,8,8"/><Button x:Name="LocalListButton" Content="读取模型" Click="LoadLocalModels" Margin="0,0,8,8"/><Button x:Name="PullButton" Content="下载推荐模型（约 1.9GB）" Click="PullModel" Margin="0,0,0,8"/></WrapPanel><Expander Header="服务地址" Margin="0,8,0,0"><TextBox x:Name="LocalEndpointInput" Margin="0,8,0,0"/></Expander></StackPanel>
   <StackPanel x:Name="CloudPanel" Visibility="Collapsed" Margin="0,16,0,0">
    <WrapPanel x:Name="QuickServices"><Button Content="智谱" Tag="zhipu" Click="QuickService" Margin="0,0,6,6" Padding="10,5"/><Button Content="DeepSeek" Tag="deepseek" Click="QuickService" Margin="0,0,6,6" Padding="10,5"/><Button Content="豆包" Tag="doubao" Click="QuickService" Margin="0,0,6,6" Padding="10,5"/><Button Content="千问" Tag="dashscope" Click="QuickService" Margin="0,0,6,6" Padding="10,5"/><Button Content="OpenAI" Tag="openai" Click="QuickService" Margin="0,0,6,6" Padding="10,5"/><Button Content="Claude" Tag="anthropic" Click="QuickService" Margin="0,0,6,6" Padding="10,5"/><Button Content="Gemini" Tag="gemini" Click="QuickService" Margin="0,0,0,6" Padding="10,5"/></WrapPanel>
    <CheckBox x:Name="ShowAllCheck" Content="显示全部平台" Checked="FilterChanged" Unchecked="FilterChanged"/><ComboBox x:Name="ServiceCombo" DisplayMemberPath="DisplayName" SelectionChanged="ServiceChanged"/>
    <StackPanel x:Name="EndpointPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="地区" Margin="0,0,0,6"/><ComboBox x:Name="EndpointCombo" DisplayMemberPath="Name" SelectionChanged="EndpointChanged"/></StackPanel>
    <StackPanel x:Name="AccountPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Cloudflare Account ID" Margin="0,0,0,6"/><TextBox x:Name="AccountInput" LostFocus="ScopeChanged"/></StackPanel>
    <Grid Margin="0,16,0,6"><TextBlock x:Name="KeyLabel" Text="API Key" VerticalAlignment="Center"/><Button Content="获取密钥" Click="OpenKeyPage" HorizontalAlignment="Right" Padding="10,3" MinHeight="28" FontSize="12"/></Grid>
    <PasswordBox x:Name="KeyInput" Padding="10,7" MinHeight="36"/>
    <Grid Margin="0,16,0,6"><TextBlock Text="模型" VerticalAlignment="Center"/><Button x:Name="FetchModelsButton" Content="读取模型列表" Click="FetchModels" HorizontalAlignment="Right" Padding="10,3" MinHeight="28" FontSize="12"/></Grid>
    <ComboBox x:Name="CloudModelCombo" IsEditable="True" SelectionChanged="ModelChanged" LostKeyboardFocus="ModelFocusLost"/><TextBlock x:Name="ModelNotice" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
    <CheckBox x:Name="CreditCheck" Content="使用账号已有额度，接受平台计费" Visibility="Collapsed"/>
    <Expander Header="平台说明" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0"><TextBlock x:Name="PolicyText" Foreground="{StaticResource Muted}" FontSize="12"/><Button Content="官方文档" Click="OpenDocs" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander>
    <Expander Header="高级设置" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0"><TextBlock x:Name="DefaultEndpointLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="CloudEndpointInput" LostFocus="ScopeChanged"/><TextBlock Text="留空使用预设 API 根地址；密钥按地址分别保存。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/><Button Content="删除此地址的本机密钥" Click="ForgetKey" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="ResultText" Text="测试发送一次固定英文短句。密钥加密保存在本机。" Foreground="{StaticResource Muted}" FontSize="12" MaxHeight="74"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="TestButton" Content="仅测试连接" Click="TestConnection" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="取消" Click="Cancel" Margin="0,0,8,0"/><Button Grid.Column="2" x:Name="UseButton" Content="测试并保存" Click="TestAndUse" Style="{StaticResource Primary}"/></Grid></StackPanel>
 </Grid></Grid>
</Window>
