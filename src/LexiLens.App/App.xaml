<Application x:Class="LexiLens.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#111316" />
    <SolidColorBrush x:Key="Panel" Color="#1A1D22" />
    <SolidColorBrush x:Key="Line" Color="#30343B" />
    <SolidColorBrush x:Key="Muted" Color="#959DAA" />
    <SolidColorBrush x:Key="Accent" Color="#E9BD82" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="#EEF0F4" />
      <Setter Property="Background" Value="{StaticResource Bg}" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEF0F4" />
      <Setter Property="Background" Value="#252A31" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#211A12" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Padding" Value="14,13" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EEF0F4" />
      <Setter Property="Background" Value="#111316" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#111316" />
      <Setter Property="Background" Value="#E1E5EA" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="35" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEF0F4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="24" />
    </Style>
  </Application.Resources>
</Application>
